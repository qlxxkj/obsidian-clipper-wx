<view class="page">
    <view class="block">
        <view class="block__label">收件箱 Worker 地址 (HTTPS)</view>
        <input
            class="input"
            placeholder="https://wechat-inbox.your-account.workers.dev"
            value="{{inbox}}"
            bindinput="onInbox"
            confirm-type="done"
        />
        <view class="help">
            Cloudflare Worker 部署地址。该域必须在小程序后台「request 合法域名」加白(HTTPS)。
        </view>
    </view>

    <view class="block">
        <view class="block__label">设备码 (6 位数字)</view>
        <input
            class="input"
            placeholder="123456"
            value="{{code}}"
            bindinput="onCode"
            maxlength="6"
            type="number"
        />
        <view class="help">
            在 Obsidian 插件「设置 → 生成」里拿到的 6 位码。两边填同一个码即绑定这台设备。
        </view>
    </view>

    <view class="actions">
        <button class="btn" bindtap="save">保存</button>
        <button class="btn btn--ghost" bindtap="test">测试连接</button>
    </view>

    <view wx:if="{{saved}}" class="ok">配置已保存</view>
</view>
