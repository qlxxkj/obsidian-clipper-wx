<view class="page">
    <view class="seg">
        <view class="seg__item {{mode === 'url' ? 'seg__item--active' : ''}}" data-mode="url" bindtap="setMode">网页链接</view>
        <view class="seg__item {{mode === 'text' ? 'seg__item--active' : ''}}" data-mode="text" bindtap="setMode">纯图文</view>
    </view>

    <view wx:if="{{mode === 'url'}}" class="block">
        <view class="block__label">链接</view>
        <input
            class="input"
            placeholder="https://example.com/article"
            value="{{url}}"
            bindinput="onUrlInput"
            confirm-type="done"
        />
    </view>

    <view wx:else class="block">
        <view class="block__label">标题（可选）</view>
        <input class="input" placeholder="笔记标题" value="{{textTitle}}" bindinput="onTextTitle" />
        <view class="block__label block__label--mt">内容（支持 Markdown / 富文本）</view>
        <textarea
            class="textarea"
            placeholder="# 标题&#10;正文内容…"
            value="{{textContent}}"
            bindinput="onTextContent"
            auto-height
        />
    </view>

    <view class="block">
        <view class="block__label">标签（可选）</view>
        <input class="input" placeholder="clippings" value="{{tag}}" bindinput="onTag" />
    </view>

    <button class="submit" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">
        {{submitting ? '投递中…' : '投到收件箱'}}
    </button>

    <view wx:if="{{notice}}" class="notice">{{notice}}</view>
    <view wx:if="{{error}}" class="error">{{error}}</view>

    <view class="hint">
        转换由桌面端 Obsidian 插件完成。请先在「设置」里填好收件箱 Worker 地址 + 6 位设备码。
    </view>
</view>
